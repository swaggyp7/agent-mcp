+# ---------------------------------------------------------------------------
+# Audit logging
+# ---------------------------------------------------------------------------
+
+_T = TypeVar("_T")
+_AUDIT_MAX_ARG_CHARS = 2000
+
+
+def _sanitize_args(args: dict[str, Any]) -> dict[str, Any]:
+    cleaned: dict[str, Any] = {}
+    for key, value in args.items():
+        if isinstance(value, str) and len(value) > _AUDIT_MAX_ARG_CHARS:
+            omitted = len(value) - _AUDIT_MAX_ARG_CHARS
+            cleaned[key] = f"{value[:_AUDIT_MAX_ARG_CHARS]}... [truncated {omitted} chars]"
+        else:
+            cleaned[key] = value
+    return cleaned
+
+
+class _AuditLogger:
+    """Thread-safe tool-call audit logger (stderr logger + optional JSONL file)."""
+
+    def __init__(self, log_path: Path | None = None) -> None:
+        self._logger = logging.getLogger("agent-mcp.audit")
+        self._lock = threading.Lock()
+        self._log_path = log_path
+        if self._log_path is not None:
+            self._log_path.parent.mkdir(parents=True, exist_ok=True)
+
+    def record(
+        self,
+        tool: str,
+        args: dict[str, Any],
+        duration_ms: float,
+        status: str,
+        error: str | None = None,
+    ) -> None:
+        safe_args = _sanitize_args(args)
+        entry: dict[str, Any] = {
+            "ts": datetime.now(timezone.utc).isoformat(timespec="milliseconds"),
+            "tool": tool,
+            "args": safe_args,
+            "duration_ms": round(duration_ms, 2),
+            "status": status,
+        }
+        if error is not None:
+            entry["error"] = error
+        line = json.dumps(entry, ensure_ascii=False, default=str)
+        self._logger.info("CALL %s", line)
+        if self._log_path is not None:
+            with self._lock:
+                with self._log_path.open("a", encoding="utf-8") as fp:
+                    fp.write(line + "\n")
+
+
+def _audited(
+    audit: _AuditLogger,
+    tool: str,
+    args: dict[str, Any],
+    fn: Callable[[], _T],
+) -> _T:
+    start = time.monotonic()
+    try:
+        result = fn()
+    except Exception as exc:
+        audit.record(
+            tool,
+            args,
+            (time.monotonic() - start) * 1000.0,
+            "error",
+            error=f"{type(exc).__name__}: {exc}",
+        )
+        raise
+    audit.record(tool, args, (time.monotonic() - start) * 1000.0, "ok")
+    return result
+
+
